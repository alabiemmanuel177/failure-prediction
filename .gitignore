__pycache__/
.pytest_cache/
*.py[cod]

# Raw and derived research data are registered by manifests, not committed by default.
data/raw/
data/derived/
*.mcap
*.db3


# Engineering/smoke episode outputs are evidence archived by manifest and
# checksum, not source. Same treatment as data/raw and data/derived.
data/engineering/

# Editor and OS noise
.DS_Store
*.swp

# Per-process ROS/Gazebo runtime logs. Regenerated on every run and not
# evidence. The research log, campaign records and topic-health summaries in
# logs/ ARE kept.
logs/ros/
logs/gazebo/
logs/campaigns/*.lock
logs/campaigns/*.pause

# colcon workspace build artefacts
ros_ws/build/
ros_ws/install/
ros_ws/log/
.venv/

# Research 2 execution residue (evidence stays in data/raw, mirrored to the HDD, released by manifest)
logs/failure-monitor/
logs/topic-health/
logs/recovery/
logs/campaigns/*.parallel/
logs/campaigns/*.drain
logs/campaigns/*.hold
logs/*.log
logs/*.out
logs/model_development/*.log
logs/analysis/*.log
logs/research-log.jsonl.corrupt-*
data/raw_unrecorded_attempts/
data/raw_engineering_smoke/
data/adapted/
# Prediction tables are regenerated from the frozen models and derived datasets; too large for git
reports/predictions/
reports/unseen_family/**/*.csv
reports/unseen_family/**/*.provenance.json
models/_incomplete_runs/
models/*/_superseded*/

# Rasterised storyboard frames are derived from the SVG frames
reports/storyboard/*/frames/*.png
